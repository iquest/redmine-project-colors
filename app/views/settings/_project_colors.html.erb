<% color_fields = ProjectCustomField.where(field_format: 'color').sorted.to_a %>
<div class="tabular settings">
  <p>
    <%= setting_label(:color_field_id) %>
    <%= select_tag('settings[color_field_id]',
                   options_for_select([['', '']] + color_fields.map { |field| [field.name, field.id.to_s] },
                                      @settings['color_field_id'].to_s)) %>
    <% if color_fields.empty? %>
      <em class="info"><%= l(:text_project_colors_no_color_field) %></em>
    <% end %>
  </p>
</div>
